<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chordata.menuplanner.controller.PlannerController"
            styleClass="tab-content">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="toolbar">
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0"/>
            </padding>
            <Button fx:id="buttonPrevWeek" styleClass="btn-nav" text="&#8249;"/>
            <Button fx:id="buttonThisWeek" text="This week"/>
            <Button fx:id="buttonNextWeek" styleClass="btn-nav" text="&#8250;"/>
            <DatePicker fx:id="datePickerWeek" prefWidth="130.0"/>
            <Label fx:id="labelWeek" styleClass="panel-title" text=""/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="buttonExport" text="Export XLSX"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.2, 0.79">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="8.0"/>
            </padding>

            <!-- Building blocks -->
            <VBox spacing="6.0" styleClass="card" minWidth="200.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <Label styleClass="panel-title" text="Compositions"/>
                <TextField fx:id="textFieldCompSearch" promptText="Search…"/>
                <ListView fx:id="listViewCompositions" VBox.vgrow="ALWAYS"/>
                <Label styleClass="panel-title" text="Recipes"/>
                <TextField fx:id="textFieldRecipeSearch" promptText="Search…"/>
                <ListView fx:id="listViewRecipes" VBox.vgrow="ALWAYS"/>
                <Label styleClass="dim" text="Drag onto a cell to plan" wrapText="true"/>
            </VBox>

            <!-- Week grid -->
            <VBox spacing="6.0" styleClass="card" minWidth="400.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <GridPane fx:id="gridPlan" hgap="4.0" vgap="4.0" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Reports -->
            <VBox spacing="10.0" minWidth="220.0">
                <VBox spacing="6.0" styleClass="card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                    <Label styleClass="panel-title" text="This week's issues"/>
                    <ScrollPane fitToWidth="true" styleClass="cell-scroll" VBox.vgrow="ALWAYS">
                        <VBox fx:id="vboxIssues" spacing="4.0">
                            <padding>
                                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
                            </padding>
                        </VBox>
                    </ScrollPane>
                </VBox>
                <VBox spacing="6.0" styleClass="card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                    <Label styleClass="panel-title" text="Repetition report"/>
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label styleClass="dim" text="From"/>
                        <DatePicker fx:id="datePickerRepFrom" prefWidth="120.0" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label styleClass="dim" text="To"/>
                        <DatePicker fx:id="datePickerRepTo" prefWidth="120.0" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" styleClass="cell-scroll" VBox.vgrow="ALWAYS">
                        <VBox fx:id="vboxRepetition" spacing="4.0">
                            <padding>
                                <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
                            </padding>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
