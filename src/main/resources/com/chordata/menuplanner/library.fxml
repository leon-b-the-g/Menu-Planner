<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.44, 0.76" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.chordata.menuplanner.controller.LibraryController"
           styleClass="tab-content">
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
    </padding>

    <!-- Recipe catalog -->
    <VBox spacing="6.0" styleClass="card" minWidth="360.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Label styleClass="panel-title" text="Recipe catalog"/>
        <TextField fx:id="textFieldRecipeSearch" promptText="Search recipes…"/>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <TextField fx:id="textFieldTagFilter" promptText="Filter by tag…" HBox.hgrow="ALWAYS"/>
            <Button fx:id="buttonTagFilterMode" text="OR"/>
            <Button fx:id="buttonClearTagFilter" text="Clear"/>
        </HBox>
        <FlowPane fx:id="flowPaneSelectedTags" hgap="6.0" vgap="6.0"/>
        <ListView fx:id="listViewRecipes" VBox.vgrow="ALWAYS"/>
        <Label styleClass="dim" text="Double-click a recipe to add it to the composition" wrapText="true"/>
    </VBox>

    <!-- Composition builder -->
    <VBox spacing="6.0" styleClass="card" minWidth="300.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Label styleClass="panel-title" text="Composition builder"/>
        <HBox spacing="6.0">
            <Button fx:id="buttonAddToComposition" maxWidth="Infinity" text="+ Add selected" HBox.hgrow="ALWAYS"/>
            <Button fx:id="buttonRemoveFromComposition" maxWidth="Infinity" text="– Remove" HBox.hgrow="ALWAYS"/>
            <Button fx:id="buttonClearComposition" maxWidth="Infinity" text="Clear" HBox.hgrow="ALWAYS"/>
        </HBox>
        <ListView fx:id="listViewSelectedRecipes" prefHeight="140.0"/>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Label styleClass="dim" text="Id:"/>
            <Label fx:id="labelCompositionId" styleClass="dim" text="–"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelCompositionStatus" text="–"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <TextField fx:id="textFieldCompositionName" promptText="Composition name…" HBox.hgrow="ALWAYS"/>
            <Button fx:id="buttonSaveComposition" styleClass="btn-primary" text="Save"/>
        </HBox>
        <Label styleClass="panel-title" text="Existing compositions"/>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <TextField fx:id="textFieldCompositionSearch" promptText="Search…" HBox.hgrow="ALWAYS"/>
            <Button fx:id="buttonDeleteComposition" text="Delete"/>
        </HBox>
        <ListView fx:id="listViewCompositions" VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- Tag assignment -->
    <VBox spacing="6.0" styleClass="card" minWidth="200.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
        </padding>
        <Label styleClass="panel-title" text="Tags"/>
        <Label fx:id="labelSelectedRecipe" styleClass="dim" text="Select a recipe to edit its tags" wrapText="true"/>
        <ScrollPane fitToWidth="true" styleClass="cell-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="vboxTagChecks" spacing="6.0">
                <padding>
                    <Insets bottom="6.0" left="6.0" right="6.0" top="6.0"/>
                </padding>
            </VBox>
        </ScrollPane>
    </VBox>
</SplitPane>
